# Reuse the validated provider runtime and weights; only adapters change.
FROM ghcr.io/la-luche/serve_luche:providers-86d4f95abb5182b268ffbc3cd50e6469ff29147a
COPY adapters/ /app/adapters/
COPY tests/ /app/tests/
RUN REQUIRE_SAPIENS_TESTS=1 python -m unittest discover -s /app/tests -v
ENV BIND_HOST=0.0.0.0 COMPILE=0 PRELOAD_MODEL=1 WARMUP_ON_START=1
ARG GIT_SHA=dev
ENV GIT_SHA=${GIT_SHA}
CMD ["python", "-u", "-m", "adapters.http_worker"]
